<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>비밀번호 변경 — HAPI Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/common.css">
  <style>
    /* 비밀번호 조건은 평상시엔 흐리게(회색) 표시하고, 입력값이 조건을 만족하면 초록,
       입력을 시작했는데 아직 못 만족하면 빨강으로 바뀐다(실시간 피드백). */
    .password-policy-hint {
      list-style: none; margin: 8px 0 18px; padding: 10px 12px;
      background: #f7f9fb; border: 1px solid var(--border); border-radius: 8px;
      display: flex; flex-direction: column; gap: 5px;
    }
    .password-policy-hint li {
      font-size: 12px; color: var(--text-light); display: flex; align-items: center; gap: 6px;
      transition: color 0.15s;
    }
    .password-policy-hint li::before {
      content: '•'; font-size: 13px; line-height: 1; color: var(--text-light);
    }
    .password-policy-hint li.rule-ok { color: var(--success); }
    .password-policy-hint li.rule-ok::before { content: '✓'; color: var(--success); font-weight: 700; }
    .password-policy-hint li.rule-fail { color: var(--danger); }
    .password-policy-hint li.rule-fail::before { content: '✕'; color: var(--danger); font-weight: 700; }
    .alert-error .policy-error-title { font-weight: 600; margin-bottom: 4px; }
    .alert-error ul { margin: 0; padding-left: 18px; }
  </style>
</head>
<body>
<div class="login-page">
  <!-- 왼쪽 브랜딩 패널 -->
  <div class="login-left">
    <div>
      <div class="login-brand-row">
        <div class="login-logo-badge">H</div>
        <div class="login-brand">Hanwha Hotels &amp; Resorts</div>
      </div>
      <div class="login-title">한화호텔앤드리조트<br>API Portal</div>
    </div>
    <ul class="login-features">
      <li>비밀번호 정책: 10~64자</li>
      <li>대/소문자·숫자·특수문자 각 1자 이상</li>
      <li>아이디 포함/3연속 동일문자 금지</li>
      <li>1년 주기 변경 권고</li>
    </ul>
    <div></div>
  </div>

  <!-- 오른쪽 폼 영역 -->
  <div class="login-right">
    <div class="login-box">

      <% if (success) { %>
      <div class="alert-success" style="margin-bottom:20px"><%= success %></div>
      <% } %>

      <div id="form-change-password">
        <h2>비밀번호 변경</h2>
        <% if (forced) { %>
        <p>최초 발급된 비밀번호는 보안을 위해 반드시 변경해야 합니다.</p>
        <% } else if (expired) { %>
        <p>비밀번호 변경 주기(1년)가 지났습니다. 계속 이용하려면 비밀번호를 변경해주세요.</p>
        <% } else { %>
        <p>현재 비밀번호를 확인한 후 새 비밀번호로 변경합니다.</p>
        <% } %>
        <% if (error) { %>
        <div class="alert-error">
          <% if (Array.isArray(error)) { %>
            <div class="policy-error-title">새 비밀번호가 아래 조건을 만족하지 않습니다</div>
            <ul>
              <% error.forEach(function(reason) { %><li><%= reason %></li><% }) %>
            </ul>
          <% } else { %>
            <%= error %>
          <% } %>
        </div>
        <% } %>
        <form class="login-form" action="/auth/change-password" method="POST">
          <div class="form-group">
            <label>현재 비밀번호</label>
            <div class="input-icon-wrap">
              <span class="input-icon input-icon-password"></span>
              <input type="password" name="current_password" placeholder="현재 비밀번호를 입력하세요" required>
            </div>
          </div>
          <div class="form-group">
            <label>새 비밀번호</label>
            <div class="input-icon-wrap">
              <span class="input-icon input-icon-password"></span>
              <input type="password" id="newPasswordInput" name="new_password" placeholder="<%= passwordMinLength %>~<%= passwordMaxLength %>자, 대/소문자·숫자·특수문자 포함" minlength="<%= passwordMinLength %>" maxlength="<%= passwordMaxLength %>" required>
            </div>
            <!-- 조건은 항상 흐리게 표시되고, 입력하는 동안 조건 충족 여부에 따라 색이 바뀐다 -->
            <ul class="password-policy-hint" id="passwordPolicyHint">
              <li data-rule="length"><%= passwordMinLength %>~<%= passwordMaxLength %>자</li>
              <li data-rule="upper">영문 대문자 포함</li>
              <li data-rule="lower">영문 소문자 포함</li>
              <li data-rule="digit">숫자 포함</li>
              <li data-rule="special">특수문자 포함</li>
              <li data-rule="space">공백 없음</li>
              <li data-rule="repeat">동일한 문자 3연속 사용 금지</li>
              <li data-rule="username">아이디(로그인 계정) 미포함</li>
            </ul>
          </div>
          <div class="form-group">
            <label>새 비밀번호 확인</label>
            <div class="input-icon-wrap">
              <span class="input-icon input-icon-password"></span>
              <input type="password" name="new_password_confirm" placeholder="새 비밀번호를 다시 입력하세요" minlength="<%= passwordMinLength %>" maxlength="<%= passwordMaxLength %>" required>
            </div>
          </div>
          <button class="btn-login" type="submit">비밀번호 변경</button>
        </form>
        <% if (!forced && !expired) { %>
        <div class="login-divider">변경을 원하지 않으신가요?</div>
        <a class="btn-partner-apply" href="/home" style="display:block;text-align:center;text-decoration:none;box-sizing:border-box">← 돌아가기</a>
        <% } %>
        <div class="login-divider">&nbsp;</div>
        <form action="/auth/logout" method="POST">
          <button class="btn-partner-apply" type="submit" style="width:100%">로그아웃</button>
        </form>
      </div>

    </div>
  </div>
</div>
<script>
  (function () {
    var input = document.getElementById('newPasswordInput');
    var hintList = document.getElementById('passwordPolicyHint');
    if (!input || !hintList) return;

    var minLength = <%- JSON.stringify(passwordMinLength) %>;
    var maxLength = <%- JSON.stringify(passwordMaxLength) %>;
    var username = <%- JSON.stringify(username || '') %>;
    var specialRe = /[!@#$%^&*()\-_=+[\]{};:'",.<>/?\\|`~]/;

    function hasRepeatingChars(value) {
      var run = 1;
      for (var i = 1; i < value.length; i += 1) {
        run = value[i] === value[i - 1] ? run + 1 : 1;
        if (run >= 3) return true;
      }
      return false;
    }

    var rules = {
      length: function (v) { return v.length >= minLength && v.length <= maxLength; },
      upper: function (v) { return /[A-Z]/.test(v); },
      lower: function (v) { return /[a-z]/.test(v); },
      digit: function (v) { return /[0-9]/.test(v); },
      special: function (v) { return specialRe.test(v); },
      space: function (v) { return !/\s/.test(v); },
      repeat: function (v) { return !hasRepeatingChars(v); },
      username: function (v) { return !username || v.toLowerCase().indexOf(username.toLowerCase()) === -1; },
    };

    function update() {
      var value = input.value;
      var started = value.length > 0;
      Object.keys(rules).forEach(function (key) {
        var li = hintList.querySelector('[data-rule="' + key + '"]');
        if (!li) return;
        var ok = started && rules[key](value);
        li.classList.toggle('rule-ok', ok);
        li.classList.toggle('rule-fail', started && !ok);
      });
    }

    input.addEventListener('input', update);
    update();
  })();
</script>
</body>
</html>
